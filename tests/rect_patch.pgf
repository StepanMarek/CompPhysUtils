\begin{tikzpicture}
\usetikzlibrary{}
\begin{axis}[width=1.0\columnwidth,
height=0.75\columnwidth,
xlabel={$c$},
ylabel={$y$},
legend style={at={(0.95,0.95)},anchor=north east},
legend columns=1,
line width=1pt
]
\addplot[name path=fill_between_lower,
sharp plot,
blue
] coordinates {
(  0.0000E+00,  0.0000E+00)
(  1.0000E+00,  1.0000E+00)
(  2.0000E+00,  2.0000E+00)
(  3.0000E+00,  3.0000E+00)
};
\addplot[name path=fill_between_upper,
sharp plot,
blue
] coordinates {
(  0.0000E+00,  1.0000E+00)
(  1.0000E+00,  2.0000E+00)
(  2.0000E+00,  5.0000E+00)
(  3.0000E+00,  1.0000E+01)
};
\addplot[blue] fill between [of=fill_between_lower and fill_between_upper];
\addlegendentry{Diff. $y=c^2+1$ and $y=c$}
\draw[solid] (axis cs:  0.0000E+00,  0.0000E+00) --(axis cs:  1.0000E+00,  0.0000E+00) -- (axis cs:  1.0000E+00,  1.0000E+00) -- (axis cs:  0.0000E+00,  1.0000E+00) -- (axis cs:  0.0000E+00,  0.0000E+00);
\end{axis}
\end{tikzpicture}
